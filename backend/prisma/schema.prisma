generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String?
  phone        String?        @unique
  openid       String?        @unique
  nickname     String?
  isGuest      Boolean        @default(false)
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  failedLogins Int            @default(0)
  lockedUntil  DateTime?
  progress     UserProgress?
  sessions     GameSession[]
  refreshTokens RefreshToken[]
  role         String         @default("player")
  stamina      Int            @default(5)
  staminaAt    DateTime       @default(now())
  coins        Int            @default(0)
  diamonds     Int            @default(0)
  lastCheckIn  DateTime?
  checkStreak  Int            @default(0)
  claimedOffers Json          @default("[]")
  tools        Json           @default("{\"hammer\":0,\"shuffle\":0,\"swap\":0}")
  friends      Json           @default("[]")
  mails        Mail[]
  orders       Order[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Level {
  id             Int    @id
  name           String
  rows           Int
  cols           Int
  colorCount     Int
  moveLimit      Int
  goalType       String
  goalPayload    Json
  twoStarMoves   Int
  threeStarMoves Int
}

model UserProgress {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxCleared Int      @default(0)
  levelStars Json     @default("{}")
  levelBest  Json     @default("{}")
  updatedAt  DateTime @updatedAt
}

model GameSession {
  id           String    @id @default(uuid())
  userId       String
  levelId      Int
  status       String    @default("playing")
  board        Json
  rngState     String
  score        Int       @default(0)
  movesLeft    Int
  moveCount    Int       @default(0)
  collected    Json      @default("{}")
  goalProgress Json
  stars        Int       @default(0)
  startedAt    DateTime  @default(now())
  lastMoveAt   DateTime  @default(now())
  endedAt      DateTime?
  durationMs   Int?
  history      Json      @default("[]")
  tools        Json      @default("{\"hammer\":3,\"shuffle\":1}")
  reward       Json      @default("{}")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, endedAt])
}

model Mail {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  reward    Json     @default("{}")
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, claimed])
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  productId String
  outTradeNo String?  @unique
  diamonds  Int
  amountFen Int
  channel   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  paidAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model SmsCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Setting {
  key   String @id
  value Json
}
