DATABASE_URL="postgresql://match:match@localhost:5432/happy_match?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# 前后端部署在不同域名时改成 none（会强制 Secure，必须走 https）
COOKIE_SAMESITE="lax"
# 小程序里用 code 换 openid 时才需要。不填则使用小程序直接传来的 openid
WECHAT_APPID=""
WECHAT_SECRET=""
# 支付回调必须是公网 https 地址，例如 https://your-domain.com
PAY_NOTIFY_BASE=""
# 支付宝手机网站支付
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
# 微信 H5 支付
WECHAT_MCH_ID=""
WECHAT_MCH_SERIAL=""
WECHAT_MCH_PRIVATE_KEY=""
WECHAT_API_V3_KEY=""
